# Copy to .env and fill in. Never commit .env.

# --- Deriv (developers.deriv.com, PAT-type app, DEMO account only) ---
DERIV_APP_ID=
DERIV_PAT=
# Optional: pin the demo account id if the account list returns several
DERIV_ACCOUNT_ID=

# --- Decision model: TypeSafe Jev (primary) ---
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# --- Decision model fallback: Cloudflare Workers AI (Clef-flash) ---
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/cloudflare/clef-flash

# --- Claude (reflection, summaries, last-resort decision fallback) ---
ANTHROPIC_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database (docker compose sets these for the containers) ---
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent
POSTGRES_PASSWORD=agent

# --- Safety ---
# 1 = refuse to start / stop trading immediately
KILL_SWITCH=0
